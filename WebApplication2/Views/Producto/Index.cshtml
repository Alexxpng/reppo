
@model IEnumerable<WebApplication1.Models.ProductoModel>

@{
    ViewBag.Title = "Productos";
}

<h2>Lista de productos</h2>

<p>
    @Html.ActionLink("Registrar producto", "Create",
        "Producto", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Descripcion</td>
                <td>@producto.Precio.ToString("F2")</td>
                <td>@producto.Stock</td>
                <td>
                    @Html.ActionLink("Detalles", "Details",
                        new { id = producto.Id }) |
                    @Html.ActionLink("Editar", "Edit",
                        new { id = producto.Id }) |
                    @Html.ActionLink("Eliminar", "Delete",
                        new { id = producto.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
